# Copy this file to .env.local and fill in local secrets.
# .env.local is ignored by git and loaded by scripts/start-*.sh.

SPRING_PROFILE='local'
BACKEND_PORT='8081'
FRONTEND_PORT='3004'
JAVA_HOME=''

DASHSCOPE_API_KEY=''
DASHSCOPE_ENABLE_THINKING='false'
# 模型（默认值即可）
DASHSCOPE_TEXT_MODEL='qwen3.6-plus'
DASHSCOPE_ASR_MODEL='qwen3-asr-flash'
DASHSCOPE_TTS_MODEL='qwen3-tts-flash'
DASHSCOPE_TTS_VOICE='Cherry'
# 单实例同时在途的大模型请求上限，按账号配额调整
DASHSCOPE_CONCURRENCY_LLM='6'
DASHSCOPE_CONCURRENCY_ASR='10'
DASHSCOPE_CONCURRENCY_TTS='6'

# 后台任务（语音转写 / 评分 / 题目语音预生成）
TASK_WORKER_ENABLED='true'
TASK_WORKER_TYPES=''

# 文件存储：auto = 配置了 OSS 密钥用 OSS，否则存本地磁盘
STORAGE_TYPE='auto'
STORAGE_LOCAL_DIR='./data/storage'
# 前端访问后端的前缀（本地开发为 /dev-api），用于生成本地文件的访问地址
STORAGE_PUBLIC_URL_PREFIX='/dev-api'
STORAGE_LOCAL_SECRET='change-me'

DB_JDBC_URL='jdbc:mysql://127.0.0.1:3306/defense_test?useUnicode=true&characterEncoding=UTF-8&useSSL=false&serverTimezone=GMT%2B8&allowMultiQueries=true'
DB_USERNAME=''
DB_PASSWORD=''

DB_TUNNEL_ENABLED='false'
DB_TUNNEL_WATCH='true'
DB_TUNNEL_CHECK_INTERVAL='5'
DB_TUNNEL_LOCAL_HOST='127.0.0.1'
DB_TUNNEL_LOCAL_PORT='13307'
DB_TUNNEL_REMOTE_HOST='127.0.0.1'
DB_TUNNEL_REMOTE_PORT='3306'
DB_TUNNEL_SSH_HOST=''
DB_TUNNEL_SSH_USER=''
DB_TUNNEL_SSH_KEY=''
DB_TUNNEL_SSH_PASSWORD=''

REDIS_HOST='127.0.0.1'
REDIS_PORT='6379'
REDIS_PASSWORD=''
JETCACHE_REDIS_URI='redis://127.0.0.1:6379/0'

ALIYUN_OSS_ENDPOINT=''
ALIYUN_OSS_ACCESS_KEY_ID=''
ALIYUN_OSS_ACCESS_KEY_SECRET=''
ALIYUN_OSS_BUCKET=''
